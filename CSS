body {
    font-family: Arial, Helvetica, sans-serif; /* Fonte universal herdada por todo o site */
    margin: 0;                                 /* Remove margens padrão do navegador */
    padding: 0;
}

header {
    background-color: #af9dde; /* cor de fundo */
    color: #050e66;            /* Cor da fonte */
    text-align: center;        /* centraliza o texto horizontalmente */
    max-width: 600px;          /* define a largura máxima que o elemento pode ter */
    margin: 0 auto;            /* centraliza o bloco inteiro na tela */
    padding: 15px;             /* espaçamento interno entre a borda e o conteúdo */
}

h1 {
    margin: 0;
}

p {
    color: #000000;
    max-width: 600px;
    margin: 0 auto;
    padding: 15px;
}

article {
    max-width: 600px;
    margin: 0 auto;
    margin-bottom: 20px; /* Empurra o artigo de baixo, criando o espaço */
}

img {
    width: 100%;               /* define a largura fixa da imagem */
    height: 350px;              /* define a altura fixa da imagem */
    border: 1px solid #7a7a7a; /* adiciona uma borda sólida de 1px */
    display: block;            /* transforma a imagem em um bloco para aceitar margens verticais e quebra de linha */
    margin: 0 auto;            /* centraliza a imagem horizontalmente na tela */
    object-fit: cover;
}

.artigo-autor {
    font-weight: bold; /* deixa o texto em negrito */
}

.texto-curto {
    font-style: italic; /* coloca o texto em itálico */
}

footer {
    background-color: #0b0126; /* Mesma cor escura do texto do header para combinar */
    color: #ffffff;            /* Cor da fonte branca para dar contraste e leitura */
    text-align: center;        /* Centraliza o texto horizontalmente */
    max-width: 600px;          /* Mantém o mesmo alinhamento do header e do main */
    margin: 0 auto;            /* Centraliza o bloco inteiro na tela */
    padding: 10px;             /* Cria um espaçamento interno para o fundo aparecer bem */
    font-size: 14px;           /* Deixa o texto do rodapé um pouco menor e discreto */
}
